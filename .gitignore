# Environment & Secret files
.env
.env.*
!.env.example
credentials.json
token.json
*.pem
*.key
*.pfx
*.p12
*.crt
*.secret

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & Build outputs
node_modules
dist
dist-ssr
*.local

# This project standardizes on npm (package-lock.json is the committed
# lockfile) -- bun's lockfiles are ignored so a local `bun install` can't
# reintroduce the multi-lockfile drift removed in this commit.
bun.lock
bun.lockb

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local visual QA output. The harnesses (qa-*.mjs) are committed on purpose —
# only their screenshot output is disposable, and each one picks its own
# directory, hence the glob rather than a single path.
.qa/
.qa-*/

# Scratch space for intermediate data (DB dumps, scraped output). Disposable,
# and may hold real user data, so it must never be committed.
.tmp/
supabase/.temp/


{
    "redirects": [
        { "source": "/marketplace", "destination": "/events", "permanent": true },
        { "source": "/marketplace/(.*)", "destination": "/events/$1", "permanent": true },
        { "source": "/communities", "destination": "/workspace-groups", "permanent": true },
        { "source": "/communities/(.*)", "destination": "/workspace-groups/$1", "permanent": true },
        { "source": "/community-posts", "destination": "/posts", "permanent": true },
        { "source": "/community-posts/(.*)", "destination": "/posts/$1", "permanent": true }
    ],
    "rewrites": [
        { "source": "/about", "destination": "/about.html" },
        { "source": "/mentors", "destination": "/mentors.html" },
        { "source": "/posts", "destination": "/posts.html" },
        { "source": "/faculty", "destination": "/faculty.html" },
        { "source": "/opportunities", "destination": "/opportunities.html" },
        { "source": "/workspace-groups", "destination": "/workspace-groups.html" },
        { "source": "/events", "destination": "/events.html" },
        { "source": "/signup", "destination": "/signup.html" },
        { "source": "/signin", "destination": "/signin.html" },
        { "source": "/contact", "destination": "/contact.html" },
        { "source": "/how-it-works", "destination": "/how-it-works.html" },
        { "source": "/find-study-partners", "destination": "/find-study-partners.html" },
        { "source": "/hackathon-partners", "destination": "/hackathon-partners.html" },
        { "source": "/blog", "destination": "/blog.html" },
        { "source": "/how-verification-works", "destination": "/how-verification-works.html" },
        { "source": "/your-data", "destination": "/your-data.html" },
        { "source": "/faculty/:slug", "destination": "/faculty/:slug.html" },
        { "source": "/opportunities/:slug", "destination": "/opportunities/:slug.html" },
        { "source": "/mentor/:slug", "destination": "/mentor/:slug.html" },
        { "source": "/mentor/:id", "destination": "/mentor/:id.html" },
        { "source": "/workspace-groups/:slug", "destination": "/workspace-groups/:slug.html" },
        { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
        { "source": "/blogs", "destination": "/blogs.html" },
        { "source": "/blogs/write", "destination": "/index.html" },
        { "source": "/blogs/:slug", "destination": "/blogs/:slug.html" },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                }
            ]
        },
        {
            "source": "/sitemap-:slug*.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                }
            ]
        },
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain"
                }
            ]
        }
    ]
}

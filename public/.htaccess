# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Set proper MIME types for SEO files
<Files "robots.txt">
    ForceType text/plain
    Header set Content-Type "text/plain; charset=utf-8"
</Files>

<Files ~ "\.(xml)$">
    ForceType application/xml
    Header set Content-Type "application/xml; charset=utf-8"
</Files>

# Set proper HTTP Status Codes
ErrorDocument 404 /404.html
ErrorDocument 403 /unauthorized.html

# Cache static files
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType text/plain "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

# Handle React Router (SPA) routes and proper HTTP status codes
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Enforce canonical host (301 redirect to www.project-fl.me)
    RewriteCond %{HTTP_HOST} !^www\.project-fl\.me$ [NC]
    RewriteCond %{HTTP_HOST} !^$ [NC]
    RewriteRule ^(.*)$ https://www.project-fl.me/$1 [L,R=301]
    
    # Allow access to static files
    RewriteRule ^robots\.txt$ - [L]
    RewriteRule ^sitemap.*\.xml$ - [L]
    RewriteRule ^\.well-known/ - [L]
    RewriteRule ^manifest\.json$ - [L]
    
    # Handle 301 redirects for moved pages
    # Example: RewriteRule ^old-page$ /new-page [R=301,L]
    
    # Handle 410 Gone for permanently removed content
    # RewriteRule ^removed-feature$ - [G,L]
    
    # Handle 404s with correct status code
    RewriteRule ^404\.html$ - [L,R=404]
    
    # Handle 403s with correct status code
    RewriteRule ^unauthorized\.html$ - [L,R=403]
    
    # Handle SPA routing - send all other requests to index.html
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Add security headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    # XSS protection
    Header set X-XSS-Protection "1; mode=block"
    # Prevent MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

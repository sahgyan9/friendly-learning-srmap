{
  "name": "friendly-learning-srmap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:dynamic-sitemap && npm run build:client && npm run build:server && npm run build:prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:prerender": "node prerender",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:dynamic-sitemap": "node generate-dynamic-sitemap.js",
    "test:migrations": "node supabase/tests/verify-migrations.mjs && node supabase/tests/verify-upgrade.mjs",
    "qa:screenshot": "node scripts/qa/qa-screenshot.mjs",
    "qa:welcome-tour": "node scripts/qa/qa-welcome-tour.mjs",
    "qa:faculty-mock": "node scripts/qa/qa-faculty-mock.mjs",
    "qa:group-channels": "node scripts/qa/qa-group-channels.mjs",
    "qa:signed-in-sweep": "node scripts/qa/qa-signed-in-sweep.mjs",
    "qa:recommended-people": "node scripts/qa/qa-recommended-people.mjs",
    "qa:welcome-tour-interests": "node scripts/qa/qa-welcome-tour-interests.mjs",
    "qa:opportunities-loop": "node scripts/qa/qa-opportunities-loop.mjs",
    "qa:workspace-redesign": "node scripts/qa/qa-workspace-redesign.mjs",
    "qa:search-insights": "node scripts/qa/qa-search-insights.mjs",
    "qa:mentor-honesty": "node scripts/qa/qa-mentor-honesty.mjs",
    "qa:message-outbox": "node scripts/qa/qa-message-outbox.mjs",
    "eval:search": "vitest run --config vitest.eval.config.ts"
